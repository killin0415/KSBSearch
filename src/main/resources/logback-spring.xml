<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- 引用 Spring Boot 預設配置 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 定義變數 -->
    <property name="APP_NAME" value="hybrid-search-es"/>
    <property name="LOG_PATH" value="${LOG_PATH:-./logs}"/>
    <property name="LOG_FILE" value="${LOG_FILE:-${LOG_PATH}/${APP_NAME}}"/>

    <!-- 定義日誌格式模式 -->
    <property name="CONSOLE_LOG_PATTERN"
              value="${CONSOLE_LOG_PATTERN:-%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd'T'HH:mm:ss.SSSXXX}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}"/>

    <property name="FILE_LOG_PATTERN"
              value="${FILE_LOG_PATTERN:-%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd'T'HH:mm:ss.SSSXXX}} ${LOG_LEVEL_PATTERN:-%5p} ${PID:- } --- [%t] %-40.40logger{39} : %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}"/>

    <!-- Console Appender for Development -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- File Appender for All Logs -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Error File Appender -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE}-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Async Appender for Performance -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="FILE"/>
    </appender>

    <!-- 默認配置 - 防止 No appenders present 警告 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- 開發環境配置 -->
    <springProfile name="dev,local">
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>

        <!-- 應用程式相關日誌 -->
        <logger name="com.hybridsearch" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </logger>

        <!-- Spring Framework 日誌 -->
        <logger name="org.springframework.web" level="DEBUG"/>
        <logger name="org.springframework.data.elasticsearch" level="DEBUG"/>
        <logger name="org.springframework.data.r2dbc" level="DEBUG"/>

        <!-- 資料庫相關日誌 -->
        <logger name="io.r2dbc" level="DEBUG"/>
        <logger name="org.elasticsearch.client" level="INFO"/>

        <!-- Redis 和 RabbitMQ 日誌 -->
        <logger name="org.springframework.data.redis" level="DEBUG"/>
        <logger name="org.springframework.amqp" level="DEBUG"/>
    </springProfile>

    <!-- 測試環境配置 -->
    <springProfile name="test">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <logger name="com.hybridsearch" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>

        <!-- 降低第三方庫日誌級別 -->
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.elasticsearch" level="WARN"/>
        <logger name="io.r2dbc" level="WARN"/>
    </springProfile>

    <!-- 生產環境配置 -->
    <springProfile name="prod,production">
        <root level="INFO">
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>

        <!-- 應用程式日誌 -->
        <logger name="com.hybridsearch" level="INFO" additivity="false">
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </logger>

        <!-- 效能監控相關 -->
        <logger name="org.springframework.boot.actuator" level="INFO"/>
        <logger name="io.micrometer" level="WARN"/>

        <!-- 第三方庫日誌級別調整 -->
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.elasticsearch.client" level="WARN"/>
        <logger name="io.r2dbc.postgresql" level="WARN"/>
        <logger name="org.springframework.amqp" level="WARN"/>
        <logger name="org.springframework.data.redis" level="WARN"/>

        <!-- 關鍵業務日誌 -->
        <logger name="com.hybridsearch.service.SearchService" level="INFO"/>
        <logger name="com.hybridsearch.service.ExportService" level="INFO"/>
        <logger name="com.hybridsearch.handler.ExportTaskHandler" level="INFO"/>

        <!-- 安全相關日誌 -->
        <logger name="org.springframework.security" level="WARN"/>
    </springProfile>

    <!-- Kubernetes 環境配置 -->
    <springProfile name="kubernetes,k8s">
        <!-- 只輸出到控制台，由 K8s 收集日誌 -->
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <logger name="com.hybridsearch" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>

        <!-- 結構化日誌格式（適合日誌聚合） -->
        <appender name="STRUCTURED_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp/>
                    <version/>
                    <logLevel/>
                    <message/>
                    <mdc/>
                    <arguments/>
                    <stackTrace/>
                </providers>
            </encoder>
        </appender>
    </springProfile>

</configuration>
